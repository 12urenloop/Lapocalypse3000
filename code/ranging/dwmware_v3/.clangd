CompileFlags:
  CompilationDatabase: .clangd-db
  Remove:
    - -fmodules-ts
    - -mlongcalls
    - -mdisable-hardware-atomics
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -fno-jump-tables
    - --param=*

Diagnostics:
  # Keep module diagnostics visible so navigation/indexing issues are easier to spot.
  UnusedIncludes: None

---
If:
  PathMatch: src/.*\.module\.cpp
CompileFlags:
  Add:
    - -xc++
    - -std=gnu++23
