NODE_ID=pi-01
SERIAL_DEVICE=/dev/ttyUSB0
SERIAL_BAUD=115200
AMQP_URL=amqp://uwb:uwb@localhost:5672
DATA_EXCHANGE=uwb.data
CONTROL_EXCHANGE=uwb.control
ERROR_EXCHANGE=uwb.errors
PUBLISH_INTERVAL_MS=200
MAX_MESSAGES_PER_SECOND=5
MAX_MEASUREMENTS_PER_MESSAGE=25
MAX_PENDING_MEASUREMENTS=5000
RECONNECT_MIN_MS=500
RECONNECT_MAX_MS=10000
